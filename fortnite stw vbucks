import time
import requests
from PIL import Image, ImageDraw, ImageFont
from io import BytesIO
import os
from bs4 import BeautifulSoup
import cloudscraper  # pip install cloudscraper beautifulsoup4 pillow requests lxml

# Headers to avoid blocks
headers = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/134.0 Safari/537.36"
}

def fetch_with_retry(url, timeout=15):
    scraper = cloudscraper.create_scraper()
    for _ in range(5):
        try:
            r = scraper.get(url, headers=headers, timeout=timeout)
            if r.status_code == 200:
                return r
            time.sleep(2)
        except Exception as e:
            print("Error:", e)
            time.sleep(2)
    raise Exception("Failed to fetch data")

def create_alert_image(data):
    # Basic image setup
    width = 800
    height = 100 + len(data) * 80
    img = Image.new('RGB', (width, height), color=(30, 30, 40))
    draw = ImageDraw.Draw(img)
    
    try:
        font = ImageFont.truetype("arial.ttf", 28)
        small_font = ImageFont.truetype("arial.ttf", 22)
    except:
        font = ImageFont.load_default()
        small_font = ImageFont.load_default()

    # Title
    draw.text((20, 20), "Fortnite STW - V-Bucks Mission Alerts", fill=(255, 215, 0), font=font)
    draw.text((20, 55), f"Total Today: {sum(int(d['vbucks'].split('x')[0]) for d in data)} V-Bucks", 
              fill=(0, 255, 100), font=small_font)

    y = 100
    for item in data:
        draw.text((20, y), f"[{item['badge']}] PWR {item['pwr']}", fill=(255, 255, 255), font=font)
        draw.text((400, y), item['vbucks'], fill=(255, 215, 0), font=font)
        y += 70

    img.save("stw_vbucks_alerts.png")
    print("✅ Image saved as stw_vbucks_alerts.png")

def get_vbucks_missions():
    print("Fetching current V-Bucks missions...")
    response = fetch_with_retry("https://fortnitedb.com/")
    soup = BeautifulSoup(response.text, 'html.parser')
    
    # Adjust selector based on current site structure (this may need minor updates)
    table = soup.find('table', class_=lambda x: x and 'summary' in x)
    if not table:
        print("No V-Bucks table found right now.")
        return []

    data = []
    for row in table.find_all('tr'):
        try:
            badge = row.find('span', class_='badge')
            if not badge:
                continue
            badge_text = badge.text.strip()
            
            pwr = row.find('td', class_='right')
            pwr_text = pwr.text.strip() if pwr else "N/A"
            
            vbucks_cell = row.find('td', class_=lambda x: x and 'mythic' in x)
            vbucks_text = vbucks_cell.get_text(strip=True) if vbucks_cell else "0x V-Bucks"
            
            data.append({
                "badge": badge_text,
                "pwr": pwr_text,
                "vbucks": vbucks_text
            })
        except:
            continue
    
    return data

if __name__ == "__main__":
    missions = get_vbucks_missions()
    if missions:
        create_alert_image(missions)
        print("✅ V-Bucks alerts image created!")
    else:
        print("No V-Bucks missions found at the moment.")