import random
import datetime
import argparse

# Mission Data
mission_types = [
    "Survivor Rescue", "Repair the Shelter", "Eliminate and Collect",
    "Defend the Atlas", "Retrieve the Data", "Ride the Storm",
    "Destroy the Encampments", "Build the Radar Grid", "Launch the Rocket",
    "Evacuate the Shelter", "Storm King Defense", "Frostnite Challenge"
]

biomes = ["Stonewood", "Plankerton", "Canny Valley", "Twine Peaks"]
difficulties = ["Plankerton", "Canny Valley", "Twine Peaks", "Legendary", "Mythic"]
objectives = [
    "Eliminate 150 Husks", "Collect 20 BluGlo", "Rescue 8 Survivors",
    "Destroy 5 Encampments", "Build and protect 3 structures",
    "Activate 4 Amplifiers", "Survive 10 minutes in the storm",
    "Defeat 3 Mini-Bosses", "Collect 10 Storm Chests"
]
rewards = ["10,000 XP", "500 Gold", "1,200 XP + Rare Schematic", 
           "Legendary Survivor", "Event Ticket x5", "Legendary Weapon Schematic"]

def generate_missions(count=3):
    today = datetime.date.today().strftime("%B %d, %Y")
    print(f"🌟 **Fortnite: Save the World Daily Missions - {today}** 🌟\n")
    
    for i in range(count):
        mission = random.choice(mission_types)
        biome = random.choice(biomes)
        difficulty = random.choice(difficulties)
        objective = random.choice(objectives)
        reward = random.choice(rewards)
        
        print(f"**Mission {i+1}: {mission}**")
        print(f"   📍 Location   : {biome}")
        print(f"   ⭐ Difficulty  : {difficulty}")
        print(f"   🎯 Objective   : {objective}")
        print(f"   🏆 Reward      : {reward}")
        print("-" * 55)

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Generate daily missions for Fortnite Save the World")
    parser.add_argument("-n", "--number", type=int, default=3, help="Number of missions to generate (default: 3)")
    args = parser.parse_args()
    
    generate_missions(args.number)